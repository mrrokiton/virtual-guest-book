# Copy to .env (repo root). Both apps/web and apps/worker read it.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://vgb:vgb@localhost:5432/vgb

BETTER_AUTH_SECRET=change-me-at-least-32-characters-long-secret
GUEST_SESSION_SECRET=change-me-another-32-characters-long-secret
# 32 random bytes, base64
PIN_ENCRYPTION_KEY=

# Object storage: MinIO locally (docker-compose), Cloudflare R2 in production.
S3_ENDPOINT=http://localhost:9000
# Host the browser uses for presigned URLs, if different from S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
# MinIO: us-east-1. Cloudflare R2: auto.
S3_REGION=us-east-1
S3_BUCKET=vgb-media
S3_ACCESS_KEY_ID=vgb-minio
S3_SECRET_ACCESS_KEY=vgb-minio-secret
S3_FORCE_PATH_STYLE=true

# local = videos stored in S3 as uploaded; cloudflare = Cloudflare Stream.
VIDEO_PROVIDER=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
# The base64 "pem" value returned by the Stream signing key API.
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=

EMAIL_FROM=Księga gości <no-reply@localhost>
# Production: Resend. Development: Mailpit from docker-compose (http://localhost:8025).
RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025

SENTRY_DSN=
